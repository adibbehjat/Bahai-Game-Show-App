{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/question.schema.json",
  "title": "Question line (one line of questions.jsonl)",
  "description": "Generated by scripts/build-format-doc.js from public/shared/schema.js. Some rules (unique choices after folding, order answer being a permutation, whitespace normalization) are enforced only by the game validator.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "q",
        "choices",
        "answer"
      ],
      "properties": {
        "type": {
          "const": "single"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "q",
        "choices",
        "answer"
      ],
      "properties": {
        "type": {
          "const": "multi"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "q",
        "answer"
      ],
      "properties": {
        "type": {
          "const": "truefalse"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "answer": {
          "type": "boolean"
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "q",
        "items",
        "answer"
      ],
      "properties": {
        "type": {
          "const": "order"
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "answer": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "clue",
        "word"
      ],
      "properties": {
        "type": {
          "const": "spell"
        },
        "clue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "word": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[\\p{L}\\p{M}'ʻ’\\- ]+$"
        },
        "accept": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[\\p{L}\\p{M}'ʻ’\\- ]+$"
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 400
        },
        "source": {
          "type": "string",
          "maxLength": 160
        },
        "time": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      },
      "additionalProperties": false
    }
  ]
}
