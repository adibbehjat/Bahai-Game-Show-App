#!/bin/sh
# Blocks commits that include env files or secret-looking content.
# Enable once per clone:  git config core.hooksPath .githooks
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)

for f in $staged; do
  case "$f" in
    .env.example) ;;
    .env|.env.*|*/.env|*/.env.*|deploy/local/*|*.pem|*.key|config.local.*)
      echo "pre-commit: refusing to commit '$f' (secret/prod file)"; fail=1 ;;
  esac
done

# Scan staged content (added lines only) for secret-looking values
patterns="ADMIN_PIN_HASH=['\"]?scrypt\\\$[0-9]+\\\$[0-9]+\\\$[0-9]+\\\$[A-Za-z0-9+/=_-]{8,}\\\$[A-Za-z0-9+/=_-]{16,}|SESSION_SECRET=['\"]?[0-9a-fA-F]{32,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{32,}"
if git diff --cached -U0 -- . ':(exclude).githooks/*' | grep -E '^\+' | grep -Eq "$patterns"; then
  echo "pre-commit: staged changes contain something that looks like a secret:"
  git diff --cached -U0 -- . ':(exclude).githooks/*' | grep -E '^\+' | grep -E "$patterns" | sed 's/=.*/=<redacted>/'
  fail=1
fi

[ $fail -eq 0 ] || { echo "Commit blocked. Move secrets to .env (gitignored)."; exit 1; }
