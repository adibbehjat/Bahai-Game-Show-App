# ------------------------------------------------------------------
# Copy to .env (gitignored) and fill in. NEVER commit .env.
# Local dev: you don't need a .env at all — `npm run dev` generates
# a one-time admin PIN and session secret in memory.
# ------------------------------------------------------------------

# development | production
NODE_ENV=development

# Interface to bind.
#   127.0.0.1  behind a reverse proxy on the same machine (Apache/nginx/Caddy). Recommended.
#   0.0.0.0    only inside a Docker container (publish the port to 127.0.0.1),
#              or in local-network mode on a private venue LAN. Never on a public server
#              without a proxy in front.
HOST=127.0.0.1

# Port the Node server listens on (nginx proxies to it in production)
PORT=3719

# Exact public origin players/hosts load the site from (used for the
# Socket.IO origin check and the QR join link). Required in production.
PUBLIC_ORIGIN=http://localhost:3719

# scrypt hash of the admin PIN. Generate with:  npm run hash-pin
# Required in production. Never put the plaintext PIN here.
# Docker Compose only: wrap the value in single quotes ('scrypt$...') because Compose
# expands $ in env files. Do NOT quote it for plain `docker run --env-file`.
ADMIN_PIN_HASH=<run npm run hash-pin>

# At least 32 random bytes, hex. Generate with:  openssl rand -hex 32
# Required in production. Signs player/host tokens.
SESSION_SECRET=<openssl rand -hex 32>

# Capacity limits
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=60

# Which reverse proxy to trust for X-Forwarded-For (per-IP rate limits).
# loopback = proxy on the same machine (Apache/nginx/Caddy on the host).
# Docker/PaaS: a specific IP/CIDR list (e.g. 172.17.0.1), or a hop count 1-3.
# "true"/trust-all is rejected at startup.
TRUST_PROXY=loopback

# Show the bundled sample/test packs (ids starting with "_") to hosts in
# production. Off by default; they are always visible in development.
SHOW_SAMPLE_PACKS=0

# Optional: where the /review page's "Report issue" button files feedback.
# e.g. https://github.com/<owner>/<repo>/issues  (leave empty to use "Copy feedback")
ISSUES_URL=
